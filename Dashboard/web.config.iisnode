<?xml version="1.0" encoding="utf-8"?>
<!-- iisnode kuruluysa web.config yerine bu dosyayı web.config olarak kullanın -->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" resourceType="Unspecified" requireAccess="Script" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="StaticContent" stopProcessing="true">
          <match url="^((css|js|lib)/.*|favicon\.ico|index\.html)$" />
          <action type="None" />
        </rule>
        <rule name="DynamicContent">
          <match url="/*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode watchedFiles="web.config;*.js;lib\*.js" />
  </system.webServer>
</configuration>
